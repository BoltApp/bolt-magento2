diff --git a/.circleci/scripts/auto-rebase.sh b/.circleci/scripts/auto-rebase.sh
--- a/.circleci/scripts/auto-rebase.sh
+++ b/.circleci/scripts/auto-rebase.sh
@@ -1,7 +1,7 @@
 #!/usr/bin/env bash
 
 # init git
-git config user.email "circleci@bolt.com"
+git config user.email "circleci@boltapp.com"
 git config user.name "Circle CI"
 
 baseBranch="master"
diff --git a/.circleci/scripts/rebase-and-unit-test.sh b/.circleci/scripts/rebase-and-unit-test.sh
--- a/.circleci/scripts/rebase-and-unit-test.sh
+++ b/.circleci/scripts/rebase-and-unit-test.sh
@@ -2,7 +2,7 @@
 merchantBranch=$1
 echo "Rebasing $merchantBranch from $CIRCLE_BRANCH"
 
-git config --global user.email "dev@bolt.com"
+git config --global user.email "dev@boltapp.com"
 git config --global user.name "Bolt Rebase & Test Bot"
 
 git checkout $merchantBranch
diff --git a/.circleci/scripts/test-merchant-branches.sh b/.circleci/scripts/test-merchant-branches.sh
--- a/.circleci/scripts/test-merchant-branches.sh
+++ b/.circleci/scripts/test-merchant-branches.sh
@@ -15,7 +15,7 @@
 fi
 
 # init git
-git config user.email "circleci@bolt.com"
+git config user.email "circleci@boltapp.com"
 git config user.name "Circle CI"
 
 vcsType=$1
